@startuml
title GeoVisLM Staging Deployment Architecture

skinparam componentStyle rectangle
skinparam shadowing false

actor User
cloud "Cloudflare" as Cloudflare
component "Cloudflare Access\nProtected Staging" as Access
component "Caddy\nReverse Proxy" as Caddy
component "Dashboard\nFastAPI / Future UI\n127.0.0.1:8000" as Dashboard
component "Worker\nBackground Jobs" as Worker
database "PostGIS\nMetadata & Run State" as Database
storage "Persistent Storage\nOutputs / Models / Media" as Storage

User --> Cloudflare
Cloudflare --> Access
Access --> Caddy
Caddy --> Dashboard
Dashboard --> Worker
Dashboard --> Database
Worker --> Database
Dashboard --> Storage
Worker --> Storage

@enduml
