@startuml
title GeoVisLM Staging Deployment Architecture

skinparam componentStyle rectangle
skinparam shadowing false

actor "Authenticated User" as User
cloud "Cloudflare" as Cloudflare
component "Cloudflare Access\noptional staging perimeter" as Access
component "Caddy\nReverse Proxy" as Caddy

rectangle "Dashboard Application\nFastAPI + first-party HTML UI" as Dashboard {
  component "Login / Signup" as Login
  component "Session Cookie\ngeovis_session" as Session
  component "Project Workspace" as Projects
  component "Runs + Uploads" as Runs
  component "Report Comments" as Comments
  component "Memberships + Invites" as Members
  component "Audit Events" as Audit
}

queue "File-Backed Job Queue" as Jobs
component "Worker Loop\nclaim, analyze, update" as Worker
database "PostGIS\noptional metadata store" as PostGIS
storage "Shared Output Storage\ninputs, maps, vectors, renders, reports, logs" as Storage

User --> Cloudflare
Cloudflare --> Access
Access --> Caddy
Caddy --> Dashboard

Login --> Session
Session --> Projects
Projects --> Members
Projects --> Runs
Runs --> Jobs : queue run
Runs --> Storage : persisted inputs
Comments --> Storage : comments.json
Members --> Storage : members.json
Audit --> Storage : audit.jsonl

Dashboard --> PostGIS : optional metadata mirror
Worker --> Jobs : poll and claim
Worker --> Storage : read inputs / write outputs
Worker --> PostGIS : optional run status and artifacts

@enduml
