@startuml
title GeoVisLM Deployment Components

skinparam componentStyle rectangle
skinparam shadowing false

package "Ingress" {
  actor "Browser User" as User
  component "Cloudflare" as Cloudflare
  component "Cloudflare Access" as Access
  component "Caddy" as Caddy
}

package "Docker Compose Stack" {
  component "Dashboard API" as Dashboard
  component "Worker Service" as Worker
  database "PostGIS" as Database
  folder "Persistent Storage" as Storage
}

User --> Cloudflare
Cloudflare --> Access
Access --> Caddy
Caddy --> Dashboard
Dashboard --> Worker
Dashboard --> Database
Worker --> Database
Dashboard --> Storage
Worker --> Storage

@enduml
