# Install as /etc/geovis-lm/offhost-backup.env, owned by root with mode 0600.
# Never place live values in Git.
B2_APPLICATION_KEY_ID=replace-with-prefix-scoped-key-id
B2_APPLICATION_KEY=replace-with-secret-application-key
B2_BUCKET=replace-with-private-bucket-name
B2_PREFIX=geovislm/production
AGE_RECIPIENT=age1replacewithpublicrecipientonly
GEOVIS_BACKUP_ALERT_URL=https://alerts.example.invalid/replace-with-secret-endpoint
GEOVIS_BACKUP_RETRIES=4
GEOVIS_BACKUP_RETRY_BASE_SECONDS=2
GEOVIS_BACKUP_RETENTION_DAYS=90
GEOVIS_BACKUP_RETENTION_MINIMUM=3
GEOVIS_RETENTION_STATE_DIR=/root/geovis-backups/offhost-retention-state
