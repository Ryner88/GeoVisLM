[Unit]
Description=GeoVisLM validated encrypted off-host backup replication
After=docker.service network-online.target
Wants=network-online.target
OnFailure=geovis-offhost-backup-alert.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/geovis-lm/offhost-backup.env
RuntimeDirectory=geovis-offhost
RuntimeDirectoryMode=0700
WorkingDirectory=/opt/geovis_lm
ExecStart=/opt/geovis_lm/scripts/run_offhost_backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/root/geovis-backups /run/geovis-offhost
ReadOnlyPaths=/var/lib/docker/volumes
RestrictSUIDSGID=true
LockPersonality=true
