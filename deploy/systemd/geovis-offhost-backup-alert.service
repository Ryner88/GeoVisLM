[Unit]
Description=Alert on failed GeoVisLM off-host backup replication

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/geovis-lm/offhost-alert.env
ExecStart=/usr/local/libexec/geovis-offhost-alert --message "systemd reported failed off-host backup replication"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictSUIDSGID=true
LockPersonality=true
