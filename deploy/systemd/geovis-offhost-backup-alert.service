[Unit]
Description=Alert on failed GeoVisLM off-host backup replication

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/geovis-lm/offhost-alert.env
WorkingDirectory=/opt/geovis_lm
ExecStart=/opt/geovis_lm/scripts/offhost_backup.py alert-test --message "systemd reported failed off-host backup replication"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
