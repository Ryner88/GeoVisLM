GEOVIS_OUTPUT_ROOT=outputs
GEOVIS_REQUIRE_AUTH=false
# Required when GEOVIS_REQUIRE_AUTH=true. Set a high-entropy value before deployment.
GEOVIS_AUTH_TOKEN=
GEOVIS_SESSION_COOKIE_SECURE=false
GEOVIS_MAX_UPLOAD_FILE_MB=250
GEOVIS_MAX_UPLOAD_BATCH_MB=1024
GEOVIS_MAX_BATCH_FILES=50

# Set this to enable PostGIS-backed operational metadata.
# GEOVIS_DATABASE_URL=postgresql://geovis:${POSTGRES_PASSWORD}@db:5432/geovis_lm
POSTGRES_PASSWORD=
